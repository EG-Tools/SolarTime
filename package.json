{
  "name": "eg-solar-time",
  "version": "0.0.61",
  "private": true,
  "description": "Cloud-backed solar-system clock with smooth camera transitions and a spherical night sky.",
  "scripts": {
    "test": "node tools/run-tests.cjs",
    "scan:space-alignments": "node tools/scan-space-alignments.cjs",
    "update:horizons-fixture": "node tools/update-horizons-fixture.cjs",
    "build:assets": "node tools/build-assets.cjs",
    "build:runtime-assets": "node tools/build-assets.cjs --runtime-only",
    "build:cloudflare": "node tools/build-cloudflare.cjs",
    "build:git": "node tools/build-git.cjs",
    "fetch:assets": "node tools/fetch-source-assets.cjs",
    "pack:media": "node tools/create-media-bundle.cjs",
    "upload:r2": "node tools/upload-r2.cjs",
    "publish:media": "npm run build:assets && npm run pack:media && npm run upload:r2",
    "deploy:cloudflare": "node tools/deploy-cloudflare.cjs",
    "test:v046": "node --test tests/v046-release.test.cjs",
    "upload:ui": "node tools/upload-ui-assets.cjs",
    "upload:windows-helper": "node tools/upload-windows-helper.cjs",
    "fetch:derived": "node tools/fetch-derived-assets.cjs",
    "pack:originals": "node tools/pack-originals.cjs",
    "restore:ui:history": "node tools/restore-ui-history.cjs",
    "test:ui": "python tests/browser/ui-regression.py",
    "deploy:shutdown": "node tools/deploy-shutdown.cjs",
    "verify:shutdown": "node tools/verify-shutdown.cjs",
    "update:cache": "node tools/code-revisions.cjs --write",
    "check:cache": "node tools/code-revisions.cjs"
  },
  "engines": {
    "node": ">=22.16"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "sharp": "^0.35.4",
    "wrangler": "^4.131.1"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19"
  }
}
